# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/

# Data directories (keep structure, ignore contents)
data/raw/*
data/interim/*
data/processed/*
data/generated/*
data/manifests/*
data/reports/*
!data/raw/.gitkeep
# Iteration 11 pilot-100 taxonomic stratum: commit the AUTHORITATIVE
# metadata + fetch provenance (small); the 432 CC-licensed photos stay
# ignored — PROVENANCE.json pins every source URL + SHA-256, so the
# exact frozen image set is re-fetchable via scripts/fetch_inat_species.py.
!data/raw/inaturalist/
data/raw/inaturalist/*
!data/raw/inaturalist/pilot_v1/
data/raw/inaturalist/pilot_v1/*
!data/raw/inaturalist/pilot_v1/annotations.json
!data/raw/inaturalist/pilot_v1/PROVENANCE.json
# Iteration 11C confirmation pool: same treatment, and for the same reason.
# The 720 CC-licensed photos stay ignored; PROVENANCE.json pins every source
# URL + SHA-256, so the 360 selected photographs are re-fetchable and their
# hashes are auditable from the commit.  Without it the confirmation pool has
# exactly the unverifiable-bytes gap 11R1 closed for local_v1: the sealed
# image manifest would assert hashes no one could check against a source.
!data/raw/inaturalist/confirm_v1/
data/raw/inaturalist/confirm_v1/*
!data/raw/inaturalist/confirm_v1/annotations.json
!data/raw/inaturalist/confirm_v1/PROVENANCE.json
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/generated/.gitkeep
!data/manifests/.gitkeep
!data/reports/.gitkeep
# Committed research-provenance reports (small, regenerable)
!data/reports/mllmu_hier_attribute_inventory.csv
!data/reports/mllmu_hier_inventory_summary.json
!data/reports/mllmu_hier_parse_coverage.json
!data/reports/mllmu_hier_association_build_report.json
!data/reports/mllmu_hier_qwen_generation_report.json
!data/reports/mllmu_hier_manual_audit_sample.json
!data/reports/mllmu_hier_semantic_chains.jsonl
!data/reports/mllmu_smoke_entities.json
!data/reports/mllmu_smoke_query_report.json
!data/reports/mllmu_smoke_target_retain.json
# Iteration 11 pilot-100 (mixed MLLMU + real iNat taxonomic stratum)
!data/reports/mllmu_pilot100_entities.json
!data/reports/mllmu_pilot100_target_retain.json
!data/reports/mllmu_pilot100_query_report.json
!data/reports/mllmu_pilot100_reference_eval.json
!data/reports/mllmu_pilot100_unlearning_selection.json
!data/reports/mllmu_pilot100_reference_provenance.json
!data/reports/mllmu_pilot100_final_evaluation.json
# The prediction parquets and sidecars above stay ignored (large, regenerable),
# but their identities must be pinned in git or "all sidecars verify" is an
# unreproducible claim about one machine's working tree.
!data/reports/mllmu_pilot100_prediction_manifest.json
# 11C preregistration evidence: the sample-size derivation must be
# committed BEFORE the confirmation split is scored, or it is not a
# preregistration.
!data/reports/mllmu_pilot100_confirmation_power.json
# The confirmation protocol freeze. Written once, before any confirmation
# probe is built or scored, and binding the checkpoints, generation settings,
# scorer, margin role, CI unit and analysis-code hashes. If this is not in
# git then "frozen before inference" is an unverifiable claim.
!data/reports/mllmu_pilot100_confirmation_freeze.json
# 11C stage 3c: WHICH 360 of the 720 drawn photographs the confirmation uses,
# selected under the frozen hash rule.  The photographs themselves are
# gitignored, so this is the committed record of their sha256, licence,
# attribution, observation id and source URL - and the evidence that none of
# them is exploratory media.
!data/reports/mllmu_confirm100_photograph_selection.json
# 11C stage 3d: the built 1,209-query confirmation split.  The dataset itself
# is committed beside this, so what this records is the build's own evidence:
# which exploratory validator errors were tolerated and why, and that the four
# measurable sealed invariants held BEFORE anything was written.
!data/reports/mllmu_confirm100_split_report.json
# 11C stage 5: the confirmation RESULT.  Negated for the same reason every
# other stage report above is: data/reports/* is ignored, so without this line
# the one artifact the whole sealed protocol exists to produce - the primary
# claims, their intervals and the Holm verdict - would be written by
# scripts/lanes/confirm100_11c5_chain.sh and then silently skipped by a plain
# `git add -A`, leaving the result only on the machine that scored it.  It was
# committed after stage 5 ran on 2026-09-09; until then its absence from the
# repository was the record that the confirmation had not been scored, and its
# presence is now the record that it has.
!data/reports/mllmu_confirm100_final_analysis.json
# 11C stage 5 evidence: the three confirmation prediction files, their sidecars
# and their generation-order records.  TRACKED, unlike the exploratory parquets
# below.  They are 132 KB; they are the bytes the committed report's
# inputs_bound pins by sha256; and they are not regenerable, because batched
# greedy decoding is not bit-stable across batch compositions and the protocol
# scores exactly once regardless.  Committing them lets a reviewer recompute
# every number in the result with no GPU, no adapter and no photograph.  What
# actually protects them is being tracked at all: git never ignores a tracked
# file, so no later pattern in this file can drop them.  The negations below are
# documentation of that decision, placed here rather than left to be inferred
# from `git ls-files`.
!data/mllmu_hier_confirm100/predictions/
!data/mllmu_hier_confirm100/predictions/**
# Frozen sha256s for every image the dataset references; binds the photographs
# the predictions were actually generated over.
!data/mllmu_hier_pilot100/image_manifest.json
# pilot runtime artifacts (large, regenerable): predictions + exports
data/mllmu_hier_pilot100/predictions*/
data/mllmu_hier_pilot100/failure_exports/
# rebuild-verification scratch (used to prove an image re-fetch leaves the
# frozen parquets byte-identical); never part of the experiment
data/_rebuild_check/
# GPU lane locks (outputs/*/ is already ignored; kept explicit)
outputs/gpu_locks/
!data/reports/mllmu_smoke_reference_eval.json
!data/reports/mllmu_smoke_scorer_audit.json
!data/reports/mllmu_smoke_unlearning_selection.json
!data/reports/mllmu_smoke_reference_provenance.json

# Outputs
outputs/*/
!outputs/env_probe/

# OS
.DS_Store
Thumbs.db

