data/salmu_hierarchical/training_*/*.jsonl
!data/salmu_hierarchical/training_*/state_pairs_manifest.json
data/salmu_hierarchical/probe_sims_unlearn_*.json
data/salmu_hierarchical/probe_sims_retain_*.json
