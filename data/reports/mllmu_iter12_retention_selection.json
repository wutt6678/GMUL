{
  "criterion": {
    "name": "D_G",
    "formula": "D_G(M_U) = sum_j w_j * |v_j(M_U) - v_j(M_G)| / sum_j w_j over the components present on both sides",
    "components": [
      "filr",
      "tga",
      "ancestor",
      "retain_same",
      "retain_other",
      "over",
      "wrong"
    ],
    "weights": {
